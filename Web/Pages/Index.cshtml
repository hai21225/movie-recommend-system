@page
@model Web.Pages.IndexModel
@{
    ViewData["Title"] = "Trang Chủ - Netflix Recommender";
}

<nav class="navbar navbar-expand-lg netflix-navbar sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand navbar-brand-custom" href="/">NETFLIX</a>
        
        <button class="navbar-collapse-btn navbar-toggler text-white border-0" type="button" data-bs-toggle="collapse" data-bs-target="#netflixNavbarContent">
            <i class="bi bi-list fs-3"></i>
        </button>

        <div class="collapse navbar-collapse" id="netflixNavbarContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 m-lg-0 ps-lg-3">
                <li class="nav-item"><a class="nav-link nav-link-custom active" href="/">Trang chủ</a></li>
                <li class="nav-item"><a class="nav-link nav-link-custom" href="#">Phim bộ</a></li>
                <li class="nav-item"><a class="nav-link nav-link-custom" href="#">Phim lẻ</a></li>
                <li class="nav-item"><a class="nav-link nav-link-custom" href="#">Mới & Phổ biến</a></li>
            </ul>

            <div class="d-flex align-items-center gap-3 flex-wrap">
                <form class="d-flex" role="search">
                    <input class="form-control search-box-custom" type="search" placeholder="Tìm tên phim..." aria-label="Search">
                    <button class="btn search-btn-custom" type="submit"><i class="bi bi-search"></i></button>
                </form>

                <div class="auth-buttons d-flex gap-2">
                    <a href="/Login" class="btn btn-netflix-secondary btn-sm"><i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập</a>
                    <a href="/Register" class="btn btn-netflix-primary btn-sm"><i class="bi bi-person-plus me-1"></i> Đăng ký</a>
                </div>
            </div>
        </div>
    </div>
</nav>

<div class="hero-banner">
    <div class="hero-content">
        <h1 class="hero-title">Stranger Things</h1>
        <p class="text-light fs-5 mb-4 shadow-sm" style="text-shadow: 1px 1px 4px rgba(0,0,0,0.8);">
            Khi một cậu bé mất tích, một thị trấn nhỏ phơi bày một bí ẩn liên quan đến các thí nghiệm bí mật, lực lượng siêu nhiên kinh hoàng và một cô bé kỳ lạ.
        </p>
        <div class="d-flex gap-3">
            <button class="btn btn-netflix-primary btn-lg px-4 py-2"><i class="bi bi-play-fill me-1"></i> Phát ngay</button>
            <button class="btn btn-netflix-secondary btn-lg px-4 py-2"><i class="bi bi-info-circle me-1"></i> Thông tin thêm</button>
        </div>
    </div>
</div>

<div class="container-fluid px-4 mt-5">
    @if (Model.IsLoading)
    {
        <div class="d-flex justify-content-center my-5 py-5">
            <div class="spinner-border text-danger" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Đang tải phim...</span>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger bg-dark text-white border-danger d-flex align-items-center rounded-3 p-3 shadow-lg mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-4 me-3"></i>
                <div>
                    <h6 class="fw-bold mb-1">Sự cố kết nối hệ thống dữ liệu</h6>
                    <span class="small text-muted">@Model.ErrorMessage</span>
                </div>
            </div>
        }

        <div class="row movie-grid">
            <div class="col-xl-2 col-lg-3 col-md-4 mb-4">
                <div class="card sidebar-genre-custom">
                    <h6 class="fw-bold text-uppercase text-danger mb-3 tracking-wider">
                        <i class="bi bi-grid-fill me-2"></i> Thể Loại
                    </h6>
                    <div class="list-group list-group-flush">
                        @if (Model.AllGenres != null && Model.AllGenres.Any())
                        {
                            @foreach (var genre in Model.AllGenres)
                            {
                                <a href="/Genre/@genre.Id" class="list-group-item list-group-item-action genre-link-custom">
                                    🎬 @genre.Name
                                </a>
                            }
                        }
                        else
                        {
                            <div class="text-muted small py-2">Chưa tải được danh mục thể loại.</div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-10 col-lg-9 col-md-8">
                <h4 class="section-title-custom">🎬 Danh sách phim dành riêng cho bạn</h4>
                
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
                    @if (Model.HomeFeeds != null && Model.HomeFeeds.Any())
                    {
                        @foreach (var movie in Model.HomeFeeds)
                        {
                            <div class="col">
                                <div class="card h-100 movie-card-custom text-white">
                                    <span class="badge-type-custom">@movie.Type</span>
                                    
                                    <div class="movie-poster-placeholder">
                                        <i class="bi bi-play-circle-fill"></i>
                                    </div>
                                    
                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                        <div>
                                            <h6 class="movie-title-custom text-truncate" title="@movie.Title">
                                                @movie.Title
                                            </h6>
                                            
                                            <div class="movie-meta-custom d-flex justify-content-between mt-2 mb-3">
                                                <span><i class="bi bi-calendar3 me-1"></i> @movie.ReleaseYear</span>
                                                <span><i class="bi bi-hourglass-split me-1"></i> @movie.Duration</span>
                                            </div>
                                        </div>
                                        
                                        <div>
                                            <a href="/MovieDetail/@movie.Id" class="btn btn-card-action w-100 btn-sm text-center">
                                                <i class="bi bi-eye-fill me-1"></i> Chi tiết
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else if (string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="col-12 text-center text-muted my-5 py-5">
                            <i class="bi bi-folder-x fs-1 text-secondary mb-3 d-block"></i>
                            <p>Hệ thống dữ liệu phim hiện tại đang trống.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>