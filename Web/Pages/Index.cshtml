@page
@model Web.Pages.IndexModel
@{
    ViewData["Title"] = "Trang Chủ - Netflix Recommender";
}

<div class="hero-carousel-container">
    <div id="netflixHeroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="4000">
        
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#netflixHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
            <button type="button" data-bs-target="#netflixHeroCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#netflixHeroCarousel" data-bs-slide-to="2"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item carousel-item-custom active">
                <div class="slide-bg-blur" style="background-image: url('https://images.unsplash.com/photo-1536440136628-849c177e76a1?q=80&w=1925&auto=format&fit=crop');"></div>
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <h1 class="slide-title">Stranger Things</h1>
                    <p class="slide-desc mb-4">Khi một cậu bé mất tích, một thị trấn nhỏ phơi bày một bí ẩn liên quan đến các thí nghiệm bí mật, lực lượng siêu nhiên kinh hoàng và một cô bé kỳ lạ.</p>
                    <div class="d-flex gap-2"><button class="btn btn-netflix-primary px-4"><i class="bi bi-play-fill"></i> Xem ngay</button></div>
                </div>
            </div>

            <div class="carousel-item carousel-item-custom">
                <div class="slide-bg-blur" style="background-image: url('https://images.unsplash.com/photo-1616530940355-351facd9524b?q=80&w=1935&auto=format&fit=crop');"></div>
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <h1 class="slide-title">Wednesday</h1>
                    <p class="slide-desc mb-4">Thông minh, mỉa mai và có chút vô cảm, Wednesday Addams điều tra một vụ án mạng hàng loạt trong khi kết bạn — và tạo ra kẻ thù mới — tại Học viện Nevermore.</p>
                    <div class="d-flex gap-2"><button class="btn btn-netflix-primary px-4"><i class="bi bi-play-fill"></i> Xem ngay</button></div>
                </div>
            </div>

            <div class="carousel-item carousel-item-custom">
                <div class="slide-bg-blur" style="background-image: url('https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=1968&auto=format&fit=crop');"></div>
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <h1 class="slide-title">The Witcher</h1>
                    <p class="slide-desc mb-4">Geralt xứ Rivia, một thợ săn quái vật đột biến, hành trình qua Lục địa để tìm kiếm vị trí của mình trong một thế giới nơi con người thường tàn ác hơn dã thú.</p>
                    <div class="d-flex gap-2"><button class="btn btn-netflix-primary px-4"><i class="bi bi-play-fill"></i> Xem ngay</button></div>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#netflixHeroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#netflixHeroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>
</div>

<div class="container-fluid px-4 mt-5">
    @if (Model.IsLoading)
    {
        <div class="d-flex justify-content-center my-5 py-5">
            <div class="spinner-border text-danger" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Đang tải phim...</span>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger bg-dark text-white border-danger d-flex align-items-center rounded-3 p-3 shadow-lg mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-4 me-3"></i>
                <div>
                    
                    <span class="small text-muted">@Model.ErrorMessage</span>
                </div>
            </div>
        }

        <div class="row movie-grid">
            <div class="col-xl-2 col-lg-3 col-md-4 mb-4">
                <div class="card sidebar-genre-custom">
                    <h6 class="fw-bold text-uppercase text-danger mb-3 tracking-wider">
                        <i class="bi bi-grid-fill me-2"></i> Thể Loại
                    </h6>
                    <div class="list-group list-group-flush">
                        @if (Model.AllGenres != null && Model.AllGenres.Any())
                        {
                            @foreach (var genre in Model.AllGenres)
                            {
                                <a href="/Genre/@genre.Id" class="list-group-item list-group-item-action genre-link-custom">
                                    🎬 @genre.Name
                                </a>
                            }
                        }
                        else
                        {
                            <div class="text-muted small py-2">Chưa tải được danh mục thể loại.</div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-10 col-lg-9 col-md-8">
                <h4 class="section-title-custom">🎬 Danh sách phim dành riêng cho bạn</h4>
                
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
                    @if (Model.HomeFeeds != null && Model.HomeFeeds.Any())
                    {
                        @foreach (var movie in Model.HomeFeeds)
                        {
                            <div class="col">
                                <div class="card h-100 movie-card-custom text-white">
                                    <span class="badge-type-custom">@movie.Type</span>
                                    
                                    <div class="movie-poster-placeholder">
                                        <i class="bi bi-play-circle-fill"></i>
                                    </div>
                                    
                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                        <div>
                                            <h6 class="movie-title-custom text-truncate" title="@movie.Title">
                                                @movie.Title
                                            </h6>
                                            <div class="movie-meta-custom d-flex justify-content-between mt-2 mb-3">
                                                <span><i class="bi bi-calendar3 me-1"></i> @movie.ReleaseYear</span>
                                                <span><i class="bi bi-hourglass-split me-1"></i> @movie.Duration</span>
                                            </div>
                                        </div>
                                        <div>
                                            <a href="/MovieDetail/@movie.ShowId" class="btn btn-card-action w-100 btn-sm text-center">
                                                <i class="bi bi-eye-fill me-1"></i> Chi tiết
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else if (string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="col-12 text-center text-muted my-5 py-5">
                            <i class="bi bi-folder-x fs-1 text-secondary mb-3 d-block"></i>
                            <p>Hệ thống dữ liệu phim hiện tại đang trống.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>