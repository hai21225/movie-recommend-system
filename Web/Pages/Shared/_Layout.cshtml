<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Netflix Recommender</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>

    <nav class="navbar navbar-expand-lg netflix-navbar sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand navbar-brand-custom" href="/">NETFLIX</a>
            
            <button class="navbar-toggler text-white border-0" type="button" data-bs-toggle="collapse" data-bs-target="#netflixNavbarContent">
                <i class="bi bi-list fs-3"></i>
            </button>

            <div class="collapse navbar-collapse" id="netflixNavbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link nav-link-custom" href="/">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link nav-link-custom" href="/?Type=TV Show">Phim bộ</a></li>
                    <li class="nav-item"><a class="nav-link nav-link-custom" href="/?Type=Movie">Phim lẻ</a></li>
                    <li class="nav-item"><a class="nav-link nav-link-custom" href="/History">Lịch sử</a></li>
                </ul>

                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <form class="d-flex" role="search">
                        <input class="form-control search-box-custom" type="search" placeholder="Tìm tên phim..." aria-label="Search">
                        <button class="btn search-btn-custom" type="submit"><i class="bi bi-search"></i></button>
                    </form>

                    <div class="auth-buttons d-flex gap-2">
                        <a href="/Login" class="btn btn-netflix-secondary btn-sm"><i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập</a>
                        <a href="/Register" class="btn btn-netflix-primary btn-sm"><i class="bi bi-person-plus me-1"></i> Đăng ký</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid m-0 p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>