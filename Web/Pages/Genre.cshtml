@page "{id:int}"
@model Web.Pages.GenreModel
@{
    ViewData["Title"] = Model.GenreName + " - Netflix Recommender";
}

<div class="container-fluid px-4 mt-5 pt-4 mb-5">

    <div class="d-flex align-items-center mb-4">
        <a href="/Index" class="btn btn-outline-light me-4 btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Trang chủ
        </a>

        <h3 class="fw-bold m-0 section-title-custom">
            🎬 Thể loại: <span class="text-danger">@Model.GenreName</span>
        </h3>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert bg-dark text-white border-secondary text-center py-5 rounded-4 shadow-lg">
            <i class="bi bi-film fs-1 text-danger d-block mb-3 opacity-75"></i>
            <h5 class="text-muted">@Model.ErrorMessage</h5>
            <a href="/Index" class="btn btn-netflix-primary mt-3 px-4">Khám phá phim khác</a>
        </div>
    }
    else if (Model.Movies == null || !Model.Movies.Any())
    {
        <div class="alert bg-dark text-white border-secondary text-center py-5 rounded-4 shadow-lg">
            <i class="bi bi-folder-x fs-1 text-danger d-block mb-3 opacity-75"></i>
            <h5 class="text-muted">Hiện tại chưa có phim nào trong danh mục này.</h5>
            <a href="/Index" class="btn btn-netflix-primary mt-3 px-4">Quay lại trang chủ</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-5 g-4">
            @foreach (var movie in Model.Movies)
            {
                <div class="col">
                    <div class="card h-100 movie-card-custom text-white border-0 shadow-sm"
                         style="cursor: pointer;"
                         onclick="window.location.href='/MovieDetail/@movie.ShowId'">

                        <span class="badge-type-custom">@movie.Type</span>

                        <div class="movie-poster-placeholder">
                            <i class="bi bi-play-circle-fill"></i>
                        </div>

                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="movie-title-custom text-truncate mb-2" title="@movie.Title">
                                    @movie.Title
                                </h6>

                                <div class="movie-meta-custom d-flex justify-content-between text-muted small mb-3">
                                    <span>
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @movie.ReleaseYear
                                    </span>

                                    <span>
                                        <i class="bi bi-hourglass-split me-1"></i>
                                        @movie.Duration
                                    </span>
                                </div>
                            </div>

                            <a href="/MovieDetail/@movie.ShowId" class="btn btn-card-action w-100 btn-sm text-center">
                                <i class="bi bi-eye-fill me-1"></i> Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>