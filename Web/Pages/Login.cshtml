@page
@model Web.Pages.LoginModel
@{
    ViewData["Title"] = "Đăng Nhập - Netflix";
}

<!-- Vùng bọc ngoài để căn giữa và tạo hình nền -->
<div class="auth-wrapper">
    
    <!-- Hộp Form lơ lửng gom nội dung gọn gàng -->
    <div class="card auth-card-premium">
        
        <h2 class="auth-header-title">Đăng Nhập</h2>

        <!-- Khối hiển thị thông báo lỗi nếu nhập sai -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger bg-dark text-white border-danger p-2 small mb-4 rounded d-flex align-items-center" role="alert">
                <i class="bi bi-x-circle-fill text-danger me-2"></i> @Model.ErrorMessage
            </div>
        }

        <!-- Khởi động Form -->
        <form method="post">
            <div class="mb-3">
                <label class="auth-label-small">Tên tài khoản (Username)</label>
                <input type="text" asp-for="Username" class="form-control auth-input-custom" placeholder="Nhập tài khoản của bạn..." required />
            </div>

            <div class="mb-4">
                <label class="auth-label-small">Mật khẩu (Password)</label>
                <input type="password" asp-for="Password" class="form-control auth-input-custom" placeholder="Nhập mật khẩu..." required />
            </div>

            <!-- Nút bấm submit bo góc rộng theo form -->
            <button type="submit" class="btn btn-auth-submit">
                Đăng Nhập
            </button>
        </form>

        <!-- Phần chân hướng dẫn sang trang Đăng Ký -->
        <div class="text-start mt-4 auth-footer-text">
            Bạn mới tham gia hệ thống? <a href="/Register" class="auth-link-highlight">Đăng ký ngay</a>
        </div>

    </div>
</div>